# Copy this file to .env and adjust the values.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Start Postgres with: docker compose up db
# (When the backend itself runs in Docker, docker-compose.yml switches the host to "db".)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/langnghe

CORS_ALLOWED_ORIGINS=http://localhost:3000
