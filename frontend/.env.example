# Copy this file to .env.local and adjust the values.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Used by server components. In Docker this is the internal backend address.
API_URL=http://localhost:8000/api/v1

# Public address of this site, used for canonical and OpenGraph (share preview) links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
